#!/usr/bin/env bash
# nepaliPatro launcher.
#   patro                 toggle the calendar popup (run again to close it)
#   patro --today         print today's date in BS and AD
#   patro --upcoming [N]  print the next N Nepali events
#   patro --notify        send today's date as a notification
set -euo pipefail

here="$(dirname "$(readlink -f "$0")")"

case "${1:-}" in
    --today | --upcoming | --notify | --offline)
        exec python3 "$here/data.py" "$@"
        ;;
    --check)
        exec python3 "$here/selfcheck.py"
        ;;
    *)
        # Pin the GL renderer. Now that vulkan-intel is installed GTK's default
        # choice is Vulkan and it works, but it costs ~130 ms more to the first
        # frame on this Iris Xe than GL does, even with a warm
        # ~/.cache/gtk-4.0/vulkan-pipeline-cache: 520 ms vs 390 ms, medians over
        # five interleaved runs. A popup that lives a few seconds is all
        # first-frame latency and no sustained drawing, so GL wins here. Drop
        # this line if that ever stops being true.
        export GSK_RENDERER=gl
        exec python3 "$here/app.py" "$@"
        ;;
esac
