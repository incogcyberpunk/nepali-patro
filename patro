#!/usr/bin/env bash
# nepaliPatro launcher.
#   patro                 toggle the calendar popup (run again to close it)
#   patro --today         print today's date in BS and AD
#   patro --upcoming [N]  print the next N Nepali events
#   patro --notify        send today's date as a notification
set -euo pipefail

here="$(dirname "$(readlink -f "$0")")"

case "${1:-}" in
    --today | --upcoming | --notify | --offline)
        exec python3 "$here/data.py" "$@"
        ;;
    --check)
        exec python3 "$here/selfcheck.py"
        ;;
    *)
        # Skip GTK's Vulkan attempt. This machine has Intel graphics but the only
        # installed Vulkan driver is nvidia's (nvidia-utils, pulled in by
        # hyprland), so the probe always fails and falls back to GL anyway,
        # costing ~250 ms of the startup. Delete this line after installing
        # vulkan-intel, which fixes the probe properly and for every GTK4 app.
        export GSK_RENDERER=gl
        exec python3 "$here/app.py" "$@"
        ;;
esac
