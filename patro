#!/usr/bin/env bash
# nepaliPatro launcher.
#   patro                 toggle the calendar popup (run again to close it)
#   patro --today         print today's date in BS and AD
#   patro --upcoming [N]  print the next N Nepali events
#   patro --notify        send today's date as a notification
set -euo pipefail

here="$(dirname -- "$(readlink -f -- "$0")")"

case "${1:-}" in
    --today | --upcoming | --notify | --offline)
        exec python3 "$here/data.py" "$@"
        ;;
    --check)
        exec python3 "$here/selfcheck.py"
        ;;
    *)
        # An instance already up? Hand it the toggle over the bus in ~26 ms
        # instead of starting a whole second Python+GTK just to deliver the
        # message and exit, which is what clicking the clock to close used to
        # cost. When nothing owns the name the call fails in ~10 ms, which is
        # the only overhead added to the open path.
        if [ $# -eq 0 ] && gdbus call --session --dest np.nepaliPatro \
                --object-path /np/nepaliPatro \
                --method org.gtk.Application.Activate '{}' >/dev/null 2>&1; then
            exit 0
        fi
        # Cairo, GTK's software renderer, beats both GPU renderers here:
        # 347 ms to first frame against 441 for gl and 521 for vulkan, medians
        # over six interleaved runs, and 90 MB RSS instead of 175 MB. A 430x683
        # popup that lives a few seconds is all first-frame latency, and skipping
        # GL context creation and shader setup is worth more than hardware
        # drawing saves. Screenshots under all three are indistinguishable.
        export GSK_RENDERER=cairo
        exec python3 "$here/app.py" "$@"
        ;;
esac
